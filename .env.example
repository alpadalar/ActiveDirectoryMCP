# ActiveDirectoryMCP environment configuration
#
# Copy this file to ".env" (which is git-ignored) and fill in real values.
# start_server.bat / start_server.sh and start_http_server.bat / start_http_server.sh
# automatically load ".env" (if present) before starting the server.
#
# Format: plain KEY=value lines. No quotes and no spaces around or inside values: the .sh
# launchers `source` this file, the .bat launchers read it literally, and both must agree.
#
# Do NOT commit ".env" - it contains secrets.
#
# Credentials: uncomment EXACTLY ONE of the two blocks below. If AZURE_KEYVAULT_URL is set
# (here or via key_vault.vault_url in the config file) it takes priority and AD_BIND_DN /
# AD_PASSWORD are never read, so leaving both blocks active makes startup depend on Azure.

# --- Path to the JSON configuration file ---
AD_MCP_CONFIG=ad-config/ad-config.json

# --- Option A: Azure Key Vault (recommended; needs the "azure" extra) ---
# AZURE_KEYVAULT_URL=https://<vault-name>.vault.azure.net/
# AZURE_KEYVAULT_SECRET_USERNAME=<secret-name-for-bind-username>
# AZURE_KEYVAULT_SECRET_PASSWORD=<secret-name-for-bind-password>
#
# Authentication to Azure uses DefaultAzureCredential (managed identity, az login, or a
# service principal via the three variables below). Leave them commented to fall back to
# managed identity / az login.
# AZURE_TENANT_ID=<tenant-id>
# AZURE_CLIENT_ID=<client-id>
# AZURE_CLIENT_SECRET=<client-secret>

# --- Option B: plaintext fallback (discouraged - prefer Option A) ---
# AD_BIND_DN=CN=svc-mcp,OU=ServiceAccounts,DC=example,DC=com
# AD_PASSWORD=YourSecurePassword

# --- HTTP transport API key (required: every HTTP request must carry it) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AD_MCP_HTTP_API_KEY=

# --- HTTP transport settings (used by start_http_server.bat / start_http_server.sh) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8813
HTTP_PATH=/activedirectory-mcp
