# ActiveDirectoryMCP environment configuration
#
# Copy this file to ".env" (which is git-ignored) and fill in real values.
# start_server.bat / start_server.sh and start_http_server.bat / start_http_server.sh
# automatically load ".env" (if present) before starting the server.
#
# Do NOT commit ".env" - it contains secrets.

# --- Path to the JSON configuration file ---
AD_MCP_CONFIG=ad-config\ad-config.json

# --- Azure Key Vault (recommended, takes priority over AD_BIND_DN/AD_PASSWORD) ---
AZURE_KEYVAULT_URL=https://your-keyvault-name.vault.azure.net/
AZURE_KEYVAULT_SECRET_USERNAME=ad-bind-username
AZURE_KEYVAULT_SECRET_PASSWORD=ad-bind-password

# Authentication to Azure uses DefaultAzureCredential (managed identity, az login, or
# a service principal via the three variables below). Leave them empty to fall back
# to managed identity / az login instead of a service principal.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Optional plaintext fallback (discouraged - prefer Key Vault above) ---
# AD_BIND_DN=CN=ServiceAccount,OU=Service Accounts,DC=domain,DC=com
# AD_PASSWORD=YourSecurePassword

# --- HTTP transport settings (used by start_http_server.bat / start_http_server.sh) ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8813
HTTP_PATH=/activedirectory-mcp
