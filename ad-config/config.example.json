{
    "active_directory": {
        "server": "ldaps://dc.example.com:636",
        "server_pool": [
            "ldaps://dc1.example.com:636",
            "ldaps://dc2.example.com:636"
        ],
        "use_ssl": true,
        "ssl_port": 636,
        "domain": "example.com",
        "base_dn": "DC=example,DC=com",
        "bind_dn": "CN=service-account,OU=Service Accounts,DC=example,DC=com",
        "timeout": 30,
        "auto_bind": true,
        "receive_timeout": 10
    },
    "organizational_units": {
        "users_ou": "OU=Users,DC=example,DC=com",
        "groups_ou": "OU=Groups,DC=example,DC=com",
        "computers_ou": "OU=Computers,DC=example,DC=com",
        "service_accounts_ou": "OU=Service Accounts,DC=example,DC=com"
    },
    "security": {
        "enable_tls": true,
        "validate_certificate": true,
        "require_secure_connection": true,
        "allow_writes": false,
        "allow_destructive": false,
        "max_list_results": 1000,
        "protect_privileged_targets": true,
        "audit_log_path": null,
        "http_auth": {
            "required": true
        }
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "active_directory_mcp.log"
    },
    "performance": {
        "max_retries": 3,
        "retry_delay": 1.0,
        "page_size": 1000
    }
}
