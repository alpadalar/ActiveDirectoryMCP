{
    "active_directory": {
        "server": "ldaps://your-ad-server.domain.com:636",
        "use_ssl": true,
        "domain": "yourdomain.com",
        "base_dn": "DC=yourdomain,DC=com",
        "bind_dn": "CN=ServiceAccount,OU=Service Accounts,DC=yourdomain,DC=com",
        "timeout": 30,
        "auto_bind": true,
        "receive_timeout": 10
    },
    "key_vault": {
        "vault_url": "https://your-keyvault-name.vault.azure.net/",
        "username_secret_name": "ad-bind-username",
        "password_secret_name": "ad-bind-password"
    },
    "organizational_units": {
        "users_ou": "OU=Users,DC=yourdomain,DC=com",
        "groups_ou": "OU=Groups,DC=yourdomain,DC=com",
        "computers_ou": "OU=Computers,DC=yourdomain,DC=com",
        "service_accounts_ou": "OU=Service Accounts,DC=yourdomain,DC=com"
    },
    "security": {
        "enable_tls": true,
        "validate_certificate": true,
        "require_secure_connection": true,
        "allow_writes": false,
        "allow_destructive": false,
        "max_list_results": 1000,
        "protect_privileged_targets": true,
        "audit_log_path": null,
        "http_auth": {
            "required": true
        }
    },
    "logging": {
        "level": "INFO",
        "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
        "file": "/var/log/activedirectory_mcp.log"
    },
    "performance": {
        "max_retries": 3,
        "retry_delay": 1.0,
        "page_size": 1000
    }
}
