{
    "mcpServers": {
        "ActiveDirectoryMCP-OpenLDAP-stdio": {
            "command": "uv",
            "args": [
                "--directory",
                "/absolute/path/to/ActiveDirectoryMCP",
                "run",
                "activedirectory-mcp"
            ],
            "env": {
                "AD_MCP_CONFIG": "/absolute/path/to/ActiveDirectoryMCP/ad-config/openldap-lab.example.json",
                "LAB_LDAP_PASSWORD": "${env:LAB_LDAP_PASSWORD}"
            }
        },
        "ActiveDirectoryMCP-OpenLDAP-HTTP": {
            "url": "http://localhost:8813/activedirectory-mcp",
            "headers": {
                "Authorization": "Bearer ${env:AD_MCP_HTTP_API_KEY}"
            }
        }
    }
}
